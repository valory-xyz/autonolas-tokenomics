value when it has to be different from zero.\"}]},\"kind\":\"dev\",\"methods\":{\"constructor\":{\"details\":\"UniswapPriceOracle constructor.\",\"params\":{\"_maxStalenessSeconds\":\"Max staleness in seconds.\",\"_minTwapWindowSeconds\":\"Min TWAP window in seconds.\",\"_minUpdateIntervalSeconds\":\"Min price update interval in seconds.\",\"_olas\":\"OLAS address.\",\"_pair\":\"LP token with OLAS.\"}},\"getPrice()\":{\"details\":\"Gets the current spot price (reserve ratio) in UQ112x112 format.\",\"returns\":{\"_0\":\"Current spot price in UQ112x112 format.\"}},\"getTWAP()\":{\"details\":\"Gets the current TWAP price in 1e18 format.      Reverts if the oracle is not initialized, observations are stale, or the TWAP window is insufficient.      Requires at least 2 updatePrice() calls for warmup.\",\"returns\":{\"_0\":\"TWAP price in 1e18 format (OLAS per secondToken).\"}},\"updatePrice()\":{\"details\":\"Records a fresh TWAP observation from the Uniswap V2 pair.\",\"returns\":{\"_0\":\"True if price update is successful.\"}}},\"title\":\"UniswapPriceOracle - a smart contract oracle wrapper for Uniswap V2 pools (BPS version)\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"updatePrice()\":{\"notice\":\"Permissionless but rate-limited to prevent griefing resets.\"}},\"version\":1}},\"settings\":{\"compilationTarget\":{\"contracts/oracles/UniswapPriceOracle.sol\":\"UniswapPriceOracle\"},\"evmVersion\":\"prague\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":@gnosis.pm/=node_modules/@gnosis.pm/\",\":@handlers/=lib/fx-portal/test/handlers/\",\":@mock/=lib/fx-portal/test/mock/\",\":@openzeppelin/=lib/fx-portal/lib/openzeppelin-contracts/\",\":@prb/=node_modules/@prb/\",\":@uniswap/=node_modules/@uniswap/\",\":@utils/=lib/fx-portal/test/utils/\",\":canonical-weth/=node_modules/canonical-weth/\",\":ds-test/=lib/solmate/lib/ds-test/src/\",\":forge-std/=lib/forge-std/src/\",\":fx-portal/